# Keep true until all provider credentials are configured.
NEXT_PUBLIC_DEMO_MODE=true
APP_BASE_URL=http://localhost:3000

# Auth0 (provision with: stripe projects add auth0/client)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Stripe payment processing (use a Stripe sandbox for the checkout demo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Neon (provision with: stripe projects add neon/postgres)
NEON_POSTGRES_CONNECTION_STRING=

# Vercel Blob (create a Blob store separately)
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_VERCEL_BLOB_ENABLED=false

# AI providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
